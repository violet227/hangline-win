<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon: WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Hangline.ico</ApplicationIcon>
    <AssemblyName>Hangline</AssemblyName>
    <RootNamespace>Hangline</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Hangline</Product>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms brings its own global usings that clash with WPF names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Resources\Hangline.ico" />
  </ItemGroup>

</Project>
